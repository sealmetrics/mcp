{
  "name": "@sealmetrics/setup-core",
  "version": "0.1.0",
  "description": "Shared setup logic (framework detection, provisioning, pixel verification, instrumentation guide, install plan and simulation) for the SealMetrics CLI and MCP server. Presentation-agnostic, zero runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "sync-guide": "node scripts/sync-guide.mjs",
    "sync-tracker": "node scripts/sync-tracker.mjs",
    "prebuild": "node scripts/sync-guide.mjs && node scripts/sync-tracker.mjs",
    "build": "tsc",
    "prepare": "node scripts/sync-guide.mjs && node scripts/sync-tracker.mjs && tsc",
    "pretest": "node scripts/sync-guide.mjs && node scripts/sync-tracker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright-core": "1.63.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.5"
  }
}
